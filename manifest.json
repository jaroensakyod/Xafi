{
  "manifest_version": 3,
  "name": "Xaffi Auto",
  "version": "1.0.0",
  "description": "Find viral posts on X (500k+ views) and generate content automatically with Grok or Gemini.",
  "permissions": [
    "alarms",
    "sidePanel",
    "storage",
    "activeTab",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://grok.com/*",
    "https://gemini.google.com/*",
    "https://trends.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content_x.js"],
      "css": ["content_x.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://grok.com/*", "https://gemini.google.com/*"],
      "js": ["content_ai.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Xaffi Auto"
  }
}
